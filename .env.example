# Database Configuration
# Leave blank or omit to use SQLite (local development)
# Set to PostgreSQL connection string for production

DATABASE_URL=

# Example PostgreSQL URL:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Example with Render:
# Get this from Render dashboard after creating PostgreSQL database
# DATABASE_URL=postgresql://churn_db_user:password@dpg-xyz.render.internal/churn_db
